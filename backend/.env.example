CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./campusshift.db
# Generate a random secret as described in README.md. Never commit the real value.
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
CLOCK_IN_EARLY_MINUTES=15
CLOCK_IN_LATE_MINUTES=30
ATTENDANCE_LATE_GRACE_MINUTES=5
APP_ENV=development
DB_POOLING=queue
DB_STATEMENT_TIMEOUT_MS=0
DB_LOCK_TIMEOUT_MS=0
DB_CONNECT_TIMEOUT=5
DB_CONNECT_ATTEMPTS=1
DB_CONNECT_BACKOFF_SECONDS=1
# Deployment: APP_ENV=production and postgresql+psycopg://user@host:5432/campusshift?sslmode=verify-full&sslrootcert=/etc/campusshift/rds-ca.pem
# PGPASSFILE=/etc/campusshift/pgpass (0600; never commit passwords)
