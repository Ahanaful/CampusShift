<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.campusshift.backup-pull</string>
  <key>ProgramArguments</key><array>
    <string>__ABSOLUTE_PYTHON__</string>
    <string>__ABSOLUTE_REPO__/scripts/sqlite_backup.py</string>
    <string>pull</string>
    <string>--host</string><string>ubuntu@3.133.115.154</string>
    <string>--identity</string><string>__ABSOLUTE_KEY__</string>
    <string>--directory</string><string>__PRIVATE_DESTINATION__</string>
    <string>--keep</string><string>30</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
</dict></plist>
