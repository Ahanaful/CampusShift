{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CampusShift Stage B: Ohio project serverless API and private Aurora. PROPOSAL ONLY; CAPABILITY_IAM and explicit cost approval required.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "campusshift-demo",
      "AllowedPattern": "[a-z][a-z0-9-]{2,23}"
    },
    "CodeBucket": {
      "Type": "String",
      "Description": "Output of approved serverless-artifacts stack"
    },
    "CodeKey": {
      "Type": "String",
      "AllowedPattern": "backend/[a-f0-9]{64}\\.zip",
      "Description": "Content-addressed Linux Python 3.12 ZIP from the local builder"
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "campusshift",
      "AllowedPattern": "[a-z][a-z0-9]{2,30}"
    },
    "DatabaseEngineVersion": {
      "Type": "String",
      "Default": "16.15",
      "AllowedPattern": "16\\.[0-9]+",
      "Description": "Recheck orderability and zero-ACU support in Ohio before execution"
    },
    "AuroraMinCapacity": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        0.5
      ],
      "Description": "0 enables pause. 0.5 is an explicit always-on cost fallback requiring a revised review."
    },
    "AuroraMaxCapacity": {
      "Type": "Number",
      "Default": 1,
      "AllowedValues": [
        1
      ]
    },
    "AutoPauseSeconds": {
      "Type": "Number",
      "Default": 300,
      "MinValue": 300,
      "MaxValue": 86400
    },
    "ApiReservedConcurrency": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1,
        2
      ],
      "Description": "0 OMIT reservation, not disable API. Current account quota=10; reservations may require >=100 unreserved capacity."
    },
    "SecretConfigRevision": {
      "Type": "String",
      "Default": "1",
      "AllowedPattern": "[a-zA-Z0-9_-]{1,24}",
      "Description": "Change deliberately when resolving rotated secret references; never pass secret values"
    }
  },
  "Rules": {
    "OhioOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-2"
            ]
          },
          "AssertDescription": "Use the assigned project region us-east-2"
        }
      ]
    }
  },
  "Conditions": {
    "WithAutoPause": {
      "Fn::Equals": [
        {
          "Ref": "AuroraMinCapacity"
        },
        0
      ]
    },
    "WithApiReservation": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApiReservedConcurrency"
            },
            0
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "CidrBlock": "10.42.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.0/26",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "PrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.64/26",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "RouteAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetA"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "RouteAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetB"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "LambdaSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "GroupDescription": "Private functions: PostgreSQL egress only, no ingress",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "127.0.0.1/32"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "GroupDescription": "Private Aurora: PostgreSQL from project functions only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "127.0.0.1/32"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "LambdaDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "GroupId": {
          "Ref": "LambdaSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Ref": "DatabaseSecurityGroup"
        }
      }
    },
    "DatabaseLambdaIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "LambdaSecurityGroup"
        }
      }
    },
    "AdminSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${EnvironmentName}/database/admin"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"campusshiftadmin\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "AppSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${EnvironmentName}/database/app"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"campusshiftapp\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "JwtSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${EnvironmentName}/auth/jwt"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "secret",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "DBSubnetGroupDescription": "Private subnets in two AZs; one serverless writer only",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "DatabaseParameters": {
      "Type": "AWS::RDS::DBClusterParameterGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "PostgreSQL requires TLS",
        "Family": "aurora-postgresql16",
        "Parameters": {
          "rds.force_ssl": "1"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBCluster",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "DBClusterIdentifier": {
          "Fn::Sub": "${EnvironmentName}-aurora"
        },
        "Engine": "aurora-postgresql",
        "EngineMode": "provisioned",
        "EngineVersion": {
          "Ref": "DatabaseEngineVersion"
        },
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "DatabaseName": {
          "Ref": "DatabaseName"
        },
        "MasterUsername": "campusshiftadmin",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${AdminSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup"
        },
        "DBClusterParameterGroupName": {
          "Ref": "DatabaseParameters"
        },
        "VpcSecurityGroupIds": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "Port": 5432,
        "StorageEncrypted": true,
        "StorageType": "aurora",
        "BackupRetentionPeriod": 1,
        "DeletionProtection": true,
        "EnableHttpEndpoint": false,
        "CopyTagsToSnapshot": true,
        "ServerlessV2ScalingConfiguration": {
          "MinCapacity": {
            "Ref": "AuroraMinCapacity"
          },
          "MaxCapacity": {
            "Ref": "AuroraMaxCapacity"
          },
          "SecondsUntilAutoPause": {
            "Fn::If": [
              "WithAutoPause",
              {
                "Ref": "AutoPauseSeconds"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "Writer": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "DBClusterIdentifier": {
          "Ref": "Database"
        },
        "Engine": "aurora-postgresql",
        "DBInstanceClass": "db.serverless",
        "PubliclyAccessible": false,
        "MonitoringInterval": 0,
        "EnablePerformanceInsights": false,
        "AutoMinorVersionUpgrade": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "FunctionLogsAndPrivateNetwork",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${EnvironmentName}-api:log-stream:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSubnets",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "lambda:SourceFunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${EnvironmentName}-api"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "JobsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "FunctionLogsAndPrivateNetwork",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${EnvironmentName}-jobs:log-stream:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSubnets",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "lambda:SourceFunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${EnvironmentName}-jobs"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${EnvironmentName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "JobsLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${EnvironmentName}-jobs"
        },
        "RetentionInDays": 7
      }
    },
    "HttpLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/campusshift/${EnvironmentName}/http"
        },
        "RetentionInDays": 7
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "Writer",
        "ApiLogs",
        "LambdaDatabaseEgress",
        "DatabaseLambdaIngress"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${EnvironmentName}-api"
        },
        "Description": "Existing JWT-protected FastAPI via Mangum; no admin jobs",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "lambda_handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 1024,
        "Timeout": 28,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "WithApiReservation",
            {
              "Ref": "ApiReservedConcurrency"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "VpcConfig": {
          "SubnetIds": [
            {
              "Ref": "PrivateSubnetA"
            },
            {
              "Ref": "PrivateSubnetB"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "LambdaSecurityGroup"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "APP_ENV": "production",
            "DB_POOLING": "null",
            "DB_CONNECT_TIMEOUT": "10",
            "DB_CONNECT_ATTEMPTS": "2",
            "DB_CONNECT_BACKOFF_SECONDS": "1",
            "JWT_SECRET": {
              "Fn::Sub": "{{resolve:secretsmanager:${JwtSecret}:SecretString:secret}}"
            },
            "JWT_EXPIRE_MINUTES": "30",
            "CORS_ORIGINS": "",
            "CLOCK_IN_EARLY_MINUTES": "15",
            "CLOCK_IN_LATE_MINUTES": "30",
            "ATTENDANCE_LATE_GRACE_MINUTES": "5",
            "SECRET_CONFIG_REVISION": {
              "Ref": "SecretConfigRevision"
            },
            "DATABASE_URL": {
              "Fn::Sub": "postgresql+psycopg://campusshiftapp@${Database.Endpoint.Address}:5432/${DatabaseName}?sslmode=verify-full&sslrootcert=/var/task/certs/rds-us-east-2.pem"
            },
            "DB_PASSWORD": {
              "Fn::Sub": "{{resolve:secretsmanager:${AppSecret}:SecretString:password}}"
            },
            "DB_STATEMENT_TIMEOUT_MS": "5000",
            "DB_LOCK_TIMEOUT_MS": "2000"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "JobsFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "Writer",
        "JobsLogs",
        "LambdaDatabaseEgress",
        "DatabaseLambdaIngress"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${EnvironmentName}-jobs"
        },
        "Description": "IAM-only migrations/check/synthetic seed; no URL or HTTP integration",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "lambda_jobs.handler",
        "Role": {
          "Fn::GetAtt": [
            "JobsRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 1024,
        "Timeout": 120,
        "VpcConfig": {
          "SubnetIds": [
            {
              "Ref": "PrivateSubnetA"
            },
            {
              "Ref": "PrivateSubnetB"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "LambdaSecurityGroup"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "APP_ENV": "production",
            "DB_POOLING": "null",
            "DB_CONNECT_TIMEOUT": "10",
            "DB_CONNECT_ATTEMPTS": "2",
            "DB_CONNECT_BACKOFF_SECONDS": "1",
            "JWT_SECRET": {
              "Fn::Sub": "{{resolve:secretsmanager:${JwtSecret}:SecretString:secret}}"
            },
            "JWT_EXPIRE_MINUTES": "30",
            "CORS_ORIGINS": "",
            "CLOCK_IN_EARLY_MINUTES": "15",
            "CLOCK_IN_LATE_MINUTES": "30",
            "ATTENDANCE_LATE_GRACE_MINUTES": "5",
            "SECRET_CONFIG_REVISION": {
              "Ref": "SecretConfigRevision"
            },
            "DATABASE_URL": {
              "Fn::Sub": "postgresql+psycopg://campusshiftadmin@${Database.Endpoint.Address}:5432/${DatabaseName}?sslmode=verify-full&sslrootcert=/var/task/certs/rds-us-east-2.pem"
            },
            "DB_PASSWORD": {
              "Fn::Sub": "{{resolve:secretsmanager:${AdminSecret}:SecretString:password}}"
            },
            "APP_DB_USERNAME": "campusshiftapp",
            "APP_DB_PASSWORD": {
              "Fn::Sub": "{{resolve:secretsmanager:${AppSecret}:SecretString:password}}"
            },
            "DB_STATEMENT_TIMEOUT_MS": "60000",
            "DB_LOCK_TIMEOUT_MS": "10000"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CampusShift"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${EnvironmentName}-api"
        },
        "ProtocolType": "HTTP",
        "Description": "Regional HTTPS; JWT authentication remains in FastAPI"
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 29000
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 2,
          "ThrottlingRateLimit": 1
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "HttpLogs",
              "Arn"
            ]
          },
          "Format": "{\"request_id\":\"$context.requestId\",\"route\":\"$context.routeKey\",\"status\":\"$context.status\",\"latency_ms\":\"$context.responseLatency\"}"
        }
      }
    },
    "ApiInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    }
  },
  "Outputs": {
    "ApiEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "ApiOriginDomain": {
      "Value": {
        "Fn::Select": [
          2,
          {
            "Fn::Split": [
              "/",
              {
                "Fn::GetAtt": [
                  "HttpApi",
                  "ApiEndpoint"
                ]
              }
            ]
          }
        ]
      }
    },
    "ApiFunctionName": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "JobsFunctionName": {
      "Value": {
        "Ref": "JobsFunction"
      }
    },
    "ClusterId": {
      "Value": {
        "Ref": "Database"
      }
    },
    "WriterId": {
      "Value": {
        "Ref": "Writer"
      }
    },
    "DatabaseHost": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabaseName": {
      "Value": {
        "Ref": "DatabaseName"
      }
    },
    "ApiLogGroup": {
      "Value": {
        "Ref": "ApiLogs"
      }
    },
    "JobsLogGroup": {
      "Value": {
        "Ref": "JobsLogs"
      }
    },
    "HttpLogGroup": {
      "Value": {
        "Ref": "HttpLogs"
      }
    }
  }
}
